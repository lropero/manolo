{
  "name": "manolo",
  "version": "0.1.0",
  "private": true,
  "description": "A poker (Texas hold'em) data generator for testing Reinforcement Learning algorithms.",
  "license": "UNLICENSED",
  "author": "Luciano Ropero <lropero@gmail.com>",
  "type": "module",
  "scripts": {
    "audit": "npx upgradeps",
    "audit:verbose": "npx upgradeps -v",
    "clean": "npx rimraf node_modules && npx rimraf package-lock.json",
    "lint": "npx prettier --write . && npx standard --fix",
    "nuke": "npm run clean && npm cache verify && npm install",
    "sort": "npx sort-package-json",
    "start": "node --max-old-space-size=4096 index.js",
    "upgrade": "npx upgradeps -u -f"
  },
  "dependencies": {
    "array-shuffle": "4.0.0",
    "chalk": "5.6.2",
    "figures": "6.1.0",
    "gradient-string": "3.0.0",
    "lodash": "4.17.21",
    "pokersolver": "2.1.4",
    "rxjs": "7.8.2",
    "strip-ansi": "7.1.2"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "rimraf": "6.1.2",
    "sort-package-json": "3.4.0",
    "standard": "17.1.2",
    "upgradeps": "2.0.9"
  }
}
